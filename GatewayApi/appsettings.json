{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        }
      },
      "order-exact-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order"
        }
      }
    },
    "Clusters": {
      "order-cluster": {
        "Destinations": {
          "destination-order": {
            "Address": "http://orderapi:8080"
          }
        }
      }
    }
  }
}
