@page "/circuit-breaker-lab"
@inject GatewayApiService ApiService
@inject ProgressService ProgressService
@inject ILogger<CircuitBreakerLab> Logger
@implements IDisposable

<PageTitle>Lab: Circuit Breaker | Escola de Microsserviços</PageTitle>

<section class="section-card lesson-module">
    <div class="module-header">
        <div class="module-number">⚡ LABORATÓRIO</div>
        <h2>Lab Interativo: Circuit Breaker com Polly</h2>
        <p class="module-subtitle">
            Veja o disjuntor funcionando em tempo real! Faça pedidos, simule falhas e 
            observe como o estado do Circuit Breaker muda de 🟢 para 🔴 automaticamente.
        </p>
    </div>

    <!-- Estado do Circuit Breaker -->
    <div class="cb-status-panel" style="border-left: 6px solid @_estado.Cor">
        <div class="cb-main-state">
            <span class="cb-emoji">@_estado.Emoji</span>
            <div>
                <h3>Estado: <strong style="color: @_estado.Cor">@_estado.Estado.ToUpper()</strong></h3>
                <p>@GetDescricaoEstado()</p>
            </div>
        </div>
        <div class="cb-counters">
            <div class="counter-card">
                <span class="counter-num">@_estado.FalhasConsecutivas / @_estado.MaxFalhas</span>
                <span>Falhas consecutivas</span>
            </div>
            <div class="counter-card">
                <span class="counter-num">@_estado.TotalBloqueadas</span>
                <span>Chamadas de pagamento rejeitadas</span>
            </div>
            <div class="counter-card">
                <span class="counter-num">@_estado.TotalSucesso</span>
                <span>Com sucesso</span>
            </div>
        </div>
    </div>

    <!-- Controles do Lab -->
    <div class="cb-controls">
        <div class="control-group">
            <p>Configuração da API: abre após <strong>@_estado.MaxFalhas falhas</strong>;
                período de espera: <strong>@_estado.TempoEsperaSegundos s</strong>.</p>
        </div>

        <div class="cb-buttons">
            <button class="btn-primary" @onclick="FazerPedidoNormal" disabled="@_executando">
                ✅ Pedido Normal
            </button>
            <button class="btn-danger" @onclick="SimularFalha" disabled="@_executando">
                💥 Simular Falha
            </button>
            <button class="btn-secondary" @onclick="ResetarCB" disabled="@_executando">
                🔄 Resetar Disjuntor
            </button>
        </div>
    </div>

    <!-- Log de eventos -->
    <div class="section-divider">📋 Log de Eventos do Disjuntor</div>
    <div class="event-log">
        @foreach (var ev in _eventos)
        {
            <div class="event-row @ev.Tipo">
                <span class="event-time">@ev.Hora</span>
                <span class="event-icon">@ev.Icone</span>
                <span class="event-msg">@ev.Mensagem</span>
                @if (ev.Tempo > 0)
                {
                    <span class="event-latencia">@ev.Tempo ms</span>
                }
            </div>
        }
        @if (_eventos.Count == 0)
        {
            <p class="empty-log">Clique em "Pedido Normal" ou "Simular Falha" para começar.</p>
        }
    </div>

    <!-- Explicação dos estados -->
    <div class="section-divider">📚 Os 3 Estados do Disjuntor</div>
    <div class="states-grid">
        <div class="state-explanation @(_estado.Estado == "Fechado" ? "state-active" : "")">
            <span>🟢</span>
            <h4>FECHADO</h4>
            <p>Tudo saudável. Requisições passam livremente.</p>
        </div>
        <div class="state-explanation @(_estado.Estado == "Aberto" ? "state-active" : "")">
            <span>🔴</span>
            <h4>ABERTO</h4>
            <p>Muitas falhas detectadas. Chamadas ao pagamento são rejeitadas sem nova tentativa de rede.</p>
        </div>
        <div class="state-explanation @(_estado.Estado == "MeioAberto" ? "state-active" : "")">
            <span>🟡</span>
            <h4>MEIO-ABERTO</h4>
            <p>Testando se o serviço voltou. Uma req. de teste passa.</p>
        </div>
    </div>
</section>

@code {
    private CircuitBreakerState _estado = new();
    private bool _executando = false;
    private readonly CancellationTokenSource _refreshCancellation = new();

    private readonly List<EventoLog> _eventos = [];

    private record EventoLog(string Hora, string Icone, string Mensagem, long Tempo, string Tipo);

    protected override async Task OnInitializedAsync()
    {
        await ProgressService.MarcarConcluidoAsync("circuit-breaker");
        await AtualizarEstadoAsync();
        _ = AtualizarPeriodicamenteAsync(_refreshCancellation.Token);
    }

    private async Task FazerPedidoNormal()
    {
        _executando = true;
        try
        {
            var resultado = await ApiService.PostOrderAsync();
            if (resultado.Sucesso)
            {
                LogEvento("✅", $"Pedido processado. Order: {resultado.OrderId}", resultado.ElapsedMs, "sucesso");
            }
            else
            {
                LogEvento("💥", resultado.Erro ?? "O pedido falhou.", resultado.ElapsedMs, "falha");
            }

            await AtualizarEstadoAsync();
        }
        finally
        {
            _executando = false;
        }
    }

    private async Task SimularFalha()
    {
        _executando = true;
        try
        {
            var resultado = await ApiService.PostOrderAsync(simulatePaymentFailure: true);
            LogEvento(
                resultado.Sucesso ? "✅" : "💥",
                resultado.Sucesso ? "O pagamento de demonstração foi aprovado." : resultado.Erro ?? "Falha simulada.",
                resultado.ElapsedMs,
                resultado.Sucesso ? "sucesso" : "falha");
            await AtualizarEstadoAsync();
        }
        finally
        {
            _executando = false;
        }
    }

    private async Task AtualizarPeriodicamenteAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(AtualizarEstadoAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task AtualizarEstadoAsync()
    {
        try
        {
            var snapshot = await ApiService.GetCircuitBreakerAsync();
            AplicarSnapshot(snapshot);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível consultar o estado do Circuit Breaker.");
            if (_eventos.Count == 0)
            {
                LogEvento("⚠️", "Não foi possível consultar o estado real do disjuntor.", 0, "falha");
            }
        }
    }

    private void AplicarSnapshot(CircuitBreakerSnapshot snapshot)
    {
        _estado.Estado = snapshot.State switch
        {
            "Open" => "Aberto",
            "HalfOpen" => "MeioAberto",
            _ => "Fechado"
        };
        _estado.FalhasConsecutivas = snapshot.ConsecutiveFailures;
        _estado.TotalBloqueadas = snapshot.TotalBlocked;
        _estado.TotalSucesso = snapshot.TotalSuccess;
        _estado.MaxFalhas = snapshot.FailureThreshold;
        _estado.TempoEsperaSegundos = snapshot.BreakDurationSeconds;
        _estado.TempoRestanteSegundos = snapshot.RemainingSeconds;
        StateHasChanged();
    }

    private async Task ResetarCB()
    {
        try
        {
            var snapshot = await ApiService.ResetCircuitBreakerAsync();
            _eventos.Clear();
            AplicarSnapshot(snapshot);
            LogEvento("🔄", "Disjuntor real resetado.", 0, "info");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível resetar o Circuit Breaker.");
            LogEvento("⚠️", "Não foi possível resetar o disjuntor. Verifique a configuração da API.", 0, "falha");
        }
    }

    private string GetDescricaoEstado() => _estado.Estado switch
    {
        "Aberto" => $"🔴 Bloqueando chamadas ao pagamento. Nova tentativa em aproximadamente {_estado.TempoRestanteSegundos}s.",
        "MeioAberto" => "🟡 Permitindo uma requisição de teste. Se funcionar → volta a Verde. Se falhar → volta a Vermelho.",
        _ => "🟢 Sistema saudável. Requisições fluindo normalmente para os microsserviços."
    };

    private void LogEvento(string icone, string msg, long tempo, string tipo)
    {
        _eventos.Insert(0, new EventoLog(DateTime.Now.ToString("HH:mm:ss"), icone, msg, tempo, tipo));
        if (_eventos.Count > 50) _eventos.RemoveAt(_eventos.Count - 1);
        StateHasChanged();
    }

    public void Dispose()
    {
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
    }
}
